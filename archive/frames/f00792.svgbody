{"vb":"1 -35 342 279","body":"\n  <defs>\n    <linearGradient id=\"grass-big\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n      <stop offset=\"0%\" stop-color=\"#2d5016\"></stop><stop offset=\"100%\" stop-color=\"#3a6b1f\"></stop>\n    </linearGradient>\n    <!-- Just the 1-yard lines. Cell centres and line midpoints are still live\n         snap targets — they are simply not drawn, because a tick at every\n         half yard turns the pitch into graph paper. -->\n    <pattern id=\"grid-big\" x=\"10\" y=\"10\" width=\"3\" height=\"3\" patternUnits=\"userSpaceOnUse\">\n      <path d=\"M 3 0 L 0 0 0 3\" fill=\"none\" stroke=\"rgba(255,255,255,0.1)\" stroke-width=\"0.2\"></path>\n    </pattern>\n    <marker id=\"arw-big\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerUnits=\"userSpaceOnUse\" markerWidth=\"4\" markerHeight=\"4\" orient=\"auto\">\n      <path d=\"M 0 0 L 10 5 L 0 10 z\" fill=\"#fbbf24\"></path>\n    </marker>\n    <!-- Runs get their own, slimmer head in white. A coach reading the picture has\n         to be able to tell at a glance which line is the ball and which is a person,\n         and colour alone does that faster than following the line to its source. -->\n    <marker id=\"run-big\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerUnits=\"userSpaceOnUse\" markerWidth=\"3.2\" markerHeight=\"3.2\" orient=\"auto\">\n      <path d=\"M 0 0 L 10 5 L 0 10 z\" fill=\"#ffffff\"></path>\n    </marker>\n  </defs>\n\n  <!-- Grass and grid run edge to edge across the whole working area, surround\n       included: the space outside the touchlines is somewhere to stage kit, not\n       a decorative border. The pattern is anchored at ORIGIN and tiles outward,\n       so the surround squares line up with the pitch squares for free. -->\n  <rect class=\"area\" x=\"1\" y=\"-35\" width=\"342\" height=\"279\" fill=\"url(#grass-big)\"></rect>\n  <rect x=\"1\" y=\"-35\" width=\"342\" height=\"279\" fill=\"url(#grid-big)\"></rect>\n  <!-- the touchline: the only thing that distinguishes pitch from surround -->\n  <rect class=\"pitch\" x=\"10\" y=\"10\" width=\"324\" height=\"204\" fill=\"none\" stroke=\"#ffffff\" stroke-width=\"1\"></rect>\n\n  <!-- the two goal ends, mirrored -->\n  <rect x=\"10\" y=\"52\" width=\"54\" height=\"120\" stroke=\"rgba(255,255,255,0.92)\" stroke-width=\"0.8\" fill=\"none\"></rect><rect x=\"10\" y=\"88\" width=\"18\" height=\"48\" stroke=\"rgba(255,255,255,0.92)\" stroke-width=\"0.6\" fill=\"none\"></rect><circle cx=\"46\" cy=\"112\" r=\"1\" fill=\"rgba(255,255,255,0.95)\"></circle><path d=\"M 64 88.75 A 29.4034 29.4034 0 0 1 64 135.25\" stroke=\"rgba(255,255,255,0.92)\" stroke-width=\"0.8\" fill=\"none\"></path>\n  <rect x=\"280\" y=\"52\" width=\"54\" height=\"120\" stroke=\"rgba(255,255,255,0.92)\" stroke-width=\"0.8\" fill=\"none\"></rect><rect x=\"316\" y=\"88\" width=\"18\" height=\"48\" stroke=\"rgba(255,255,255,0.92)\" stroke-width=\"0.6\" fill=\"none\"></rect><circle cx=\"298\" cy=\"112\" r=\"1\" fill=\"rgba(255,255,255,0.95)\"></circle><path d=\"M 280 88.75 A 29.4034 29.4034 0 0 0 280 135.25\" stroke=\"rgba(255,255,255,0.92)\" stroke-width=\"0.8\" fill=\"none\"></path>\n\n  <!-- centre -->\n  <line x1=\"172\" y1=\"10\" x2=\"172\" y2=\"214\" stroke=\"rgba(255,255,255,0.92)\" stroke-width=\"1\"></line>\n  <circle cx=\"172\" cy=\"112\" r=\"30\" stroke=\"rgba(255,255,255,0.92)\" stroke-width=\"0.8\" fill=\"none\"></circle>\n  <circle cx=\"172\" cy=\"112\" r=\"1.5\" fill=\"rgba(255,255,255,0.95)\"></circle>\n\n  <g class=\"ref-lines\"><line x1=\"10\" y1=\"52\" x2=\"334\" y2=\"52\" stroke=\"rgba(255,255,255,0.72)\" stroke-width=\"0.55\" stroke-dasharray=\"2.5 2.5\" fill=\"none\"></line><line x1=\"10\" y1=\"172\" x2=\"334\" y2=\"172\" stroke=\"rgba(255,255,255,0.72)\" stroke-width=\"0.55\" stroke-dasharray=\"2.5 2.5\" fill=\"none\"></line><line x1=\"64\" y1=\"88\" x2=\"280\" y2=\"88\" stroke=\"rgba(255,255,255,0.72)\" stroke-width=\"0.55\" stroke-dasharray=\"2.5 2.5\" fill=\"none\"></line><line x1=\"64\" y1=\"136\" x2=\"280\" y2=\"136\" stroke=\"rgba(255,255,255,0.72)\" stroke-width=\"0.55\" stroke-dasharray=\"2.5 2.5\" fill=\"none\"></line><line x1=\"118\" y1=\"10\" x2=\"118\" y2=\"214\" stroke=\"rgba(255,255,255,0.72)\" stroke-width=\"0.55\" stroke-dasharray=\"2.5 2.5\" fill=\"none\" data-cross=\"1\"></line><line x1=\"226\" y1=\"10\" x2=\"226\" y2=\"214\" stroke=\"rgba(255,255,255,0.72)\" stroke-width=\"0.55\" stroke-dasharray=\"2.5 2.5\" fill=\"none\" data-cross=\"1\"></line></g>\n\n  <g class=\"tape-layer\"></g>\n  <!-- Under the runs and the ball: a unit hull is the ground a block covers, so\n       it reads as territory rather than as another line drawn on top. -->\n  <g class=\"unit-layer\"></g>\n  <g class=\"run-layer\"></g>\n  <g class=\"path-layer\"><line x1=\"70.97\" y1=\"111.75\" x2=\"100.62\" y2=\"57.94\" stroke=\"#fbbf24\" stroke-width=\"0.55\" stroke-dasharray=\"2 1.6\" stroke-linecap=\"round\" marker-end=\"url(#arw-big)\" opacity=\"0.95\"></line><line x1=\"101.64\" y1=\"57.83\" x2=\"136.46\" y2=\"98.47\" stroke=\"#fbbf24\" stroke-width=\"0.55\" stroke-dasharray=\"2 1.6\" stroke-linecap=\"round\" marker-end=\"url(#arw-big)\" opacity=\"0.95\"></line><line x1=\"137.47\" y1=\"98.35\" x2=\"158.53\" y2=\"57.95\" stroke=\"#fbbf24\" stroke-width=\"0.55\" stroke-dasharray=\"2 1.6\" stroke-linecap=\"round\" marker-end=\"url(#arw-big)\" opacity=\"0.95\"></line><g data-stop=\"0\">\n       <circle cx=\"67.6\" cy=\"111.1\" r=\"1.6\" fill=\"#fbbf24\" stroke=\"rgba(0,0,0,0.5)\" stroke-width=\"0.2\"></circle>\n       <text x=\"67.6\" y=\"111.75\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"2.2\" font-weight=\"700\" fill=\"#3b2600\">1</text>\n       <circle class=\"stop-hit\" cx=\"67.6\" cy=\"111.1\" r=\"2.6\"></circle>\n     </g><g data-stop=\"1\">\n       <circle cx=\"98.64999999999999\" cy=\"54.75\" r=\"1.6\" fill=\"#fbbf24\" stroke=\"rgba(0,0,0,0.5)\" stroke-width=\"0.2\"></circle>\n       <text x=\"98.64999999999999\" y=\"55.4\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"2.2\" font-weight=\"700\" fill=\"#3b2600\">2</text>\n       <circle class=\"stop-hit\" cx=\"98.64999999999999\" cy=\"54.75\" r=\"2.6\"></circle>\n     </g><g data-stop=\"2\">\n       <circle cx=\"134.65\" cy=\"96.75\" r=\"1.6\" fill=\"#fbbf24\" stroke=\"rgba(0,0,0,0.5)\" stroke-width=\"0.2\"></circle>\n       <text x=\"134.65\" y=\"97.4\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"2.2\" font-weight=\"700\" fill=\"#3b2600\">3</text>\n       <circle class=\"stop-hit\" cx=\"134.65\" cy=\"96.75\" r=\"2.6\"></circle>\n     </g><g data-stop=\"3\">\n       <circle cx=\"156.54999999999998\" cy=\"54.75\" r=\"1.6\" fill=\"#fbbf24\" stroke=\"rgba(0,0,0,0.5)\" stroke-width=\"0.2\"></circle>\n       <text x=\"156.54999999999998\" y=\"55.4\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"2.2\" font-weight=\"700\" fill=\"#3b2600\">4</text>\n       <circle class=\"stop-hit\" cx=\"156.54999999999998\" cy=\"54.75\" r=\"2.6\"></circle>\n     </g></g>\n  <g class=\"item-layer\"><g class=\"item\" data-id=\"i55\" data-type=\"playerBlue\" transform=\"translate(70 113.5) rotate(0)\"><circle cx=\"0\" cy=\"0\" r=\"1.8\" fill=\"transparent\"></circle>\n          <path d=\"M 0 -1.40\n   C 0.92 -1.28, 1.40 -0.62, 1.40 0\n   A 1.40 1.40 0 0 1 -1.40 0\n   C -1.40 -0.62, -0.92 -1.28, 0 -1.40 Z\" fill=\"#2563eb\" stroke=\"rgba(0,0,0,0.55)\" stroke-width=\"0.16\" stroke-linejoin=\"round\"></path>\n          <circle cx=\"-0.520\" cy=\"-0.72\" r=\"0.25\" fill=\"#ffffff\" fill-opacity=\"0.78\"></circle><circle cx=\"0.520\" cy=\"-0.72\" r=\"0.25\" fill=\"#ffffff\" fill-opacity=\"0.78\"></circle>\n          <text x=\"0\" y=\"0.95\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"1.6\" font-weight=\"700\" fill=\"#ffffff\">1</text></g><g class=\"item\" data-id=\"i56\" data-type=\"playerBlue\" transform=\"translate(100 59.5) rotate(0)\"><circle cx=\"0\" cy=\"0\" r=\"1.8\" fill=\"transparent\"></circle>\n          <path d=\"M 0 -1.40\n   C 0.92 -1.28, 1.40 -0.62, 1.40 0\n   A 1.40 1.40 0 0 1 -1.40 0\n   C -1.40 -0.62, -0.92 -1.28, 0 -1.40 Z\" fill=\"#2563eb\" stroke=\"rgba(0,0,0,0.55)\" stroke-width=\"0.16\" stroke-linejoin=\"round\"></path>\n          <circle cx=\"-0.520\" cy=\"-0.72\" r=\"0.25\" fill=\"#ffffff\" fill-opacity=\"0.78\"></circle><circle cx=\"0.520\" cy=\"-0.72\" r=\"0.25\" fill=\"#ffffff\" fill-opacity=\"0.78\"></circle>\n          <text x=\"0\" y=\"0.95\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"1.6\" font-weight=\"700\" fill=\"#ffffff\">2</text></g><g class=\"item\" data-id=\"i57\" data-type=\"playerBlue\" transform=\"translate(136 101.5) rotate(0)\"><circle cx=\"0\" cy=\"0\" r=\"1.8\" fill=\"transparent\"></circle>\n          <path d=\"M 0 -1.40\n   C 0.92 -1.28, 1.40 -0.62, 1.40 0\n   A 1.40 1.40 0 0 1 -1.40 0\n   C -1.40 -0.62, -0.92 -1.28, 0 -1.40 Z\" fill=\"#2563eb\" stroke=\"rgba(0,0,0,0.55)\" stroke-width=\"0.16\" stroke-linejoin=\"round\"></path>\n          <circle cx=\"-0.520\" cy=\"-0.72\" r=\"0.25\" fill=\"#ffffff\" fill-opacity=\"0.78\"></circle><circle cx=\"0.520\" cy=\"-0.72\" r=\"0.25\" fill=\"#ffffff\" fill-opacity=\"0.78\"></circle>\n          <text x=\"0\" y=\"0.95\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"1.6\" font-weight=\"700\" fill=\"#ffffff\">3</text></g><g class=\"item\" data-id=\"i58\" data-type=\"playerBlue\" transform=\"translate(160 59.5) rotate(0)\"><circle cx=\"0\" cy=\"0\" r=\"1.8\" fill=\"transparent\"></circle>\n          <path d=\"M 0 -1.40\n   C 0.92 -1.28, 1.40 -0.62, 1.40 0\n   A 1.40 1.40 0 0 1 -1.40 0\n   C -1.40 -0.62, -0.92 -1.28, 0 -1.40 Z\" fill=\"#2563eb\" stroke=\"rgba(0,0,0,0.55)\" stroke-width=\"0.16\" stroke-linejoin=\"round\"></path>\n          <circle cx=\"-0.520\" cy=\"-0.72\" r=\"0.25\" fill=\"#ffffff\" fill-opacity=\"0.78\"></circle><circle cx=\"0.520\" cy=\"-0.72\" r=\"0.25\" fill=\"#ffffff\" fill-opacity=\"0.78\"></circle>\n          <text x=\"0\" y=\"0.95\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"1.6\" font-weight=\"700\" fill=\"#ffffff\">4</text></g></g>\n  <g class=\"play-layer\"><circle cx=\"73.86083802917709\" cy=\"106.49329394704898\" r=\"1.5\" fill=\"rgba(0,0,0,0.35)\" opacity=\"0.5\"></circle>\n          <circle cx=\"73.86083802917709\" cy=\"106.49329394704898\" r=\"1.15\" fill=\"#ffffff\" stroke=\"#1a1a1a\" stroke-width=\"0.28\"></circle>\n          <circle cx=\"73.86083802917709\" cy=\"106.49329394704898\" r=\"0.42\" fill=\"#1a1a1a\"></circle></g>\n  <g class=\"sel-layer\"></g>\n  <g class=\"ghost-layer\"></g>\n","cap":"Named feet","sub":"the ball is played to that foot, not the man"}