{"vb":"1 -35 342 279","body":"\n  <defs>\n    <linearGradient id=\"grass-big\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n      <stop offset=\"0%\" stop-color=\"#2d5016\"></stop><stop offset=\"100%\" stop-color=\"#3a6b1f\"></stop>\n    </linearGradient>\n    <!-- Just the 1-yard lines. Cell centres and line midpoints are still live\n         snap targets — they are simply not drawn, because a tick at every\n         half yard turns the pitch into graph paper. -->\n    <pattern id=\"grid-big\" x=\"10\" y=\"10\" width=\"3\" height=\"3\" patternUnits=\"userSpaceOnUse\">\n      <path d=\"M 3 0 L 0 0 0 3\" fill=\"none\" stroke=\"rgba(255,255,255,0.1)\" stroke-width=\"0.2\"></path>\n    </pattern>\n    <marker id=\"arw-big\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerUnits=\"userSpaceOnUse\" markerWidth=\"4\" markerHeight=\"4\" orient=\"auto\">\n      <path d=\"M 0 0 L 10 5 L 0 10 z\" fill=\"#fbbf24\"></path>\n    </marker>\n    <!-- Runs get their own, slimmer head in white. A coach reading the picture has\n         to be able to tell at a glance which line is the ball and which is a person,\n         and colour alone does that faster than following the line to its source. -->\n    <marker id=\"run-big\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerUnits=\"userSpaceOnUse\" markerWidth=\"3.2\" markerHeight=\"3.2\" orient=\"auto\">\n      <path d=\"M 0 0 L 10 5 L 0 10 z\" fill=\"#ffffff\"></path>\n    </marker>\n  </defs>\n\n  <!-- Grass and grid run edge to edge across the whole working area, surround\n       included: the space outside the touchlines is somewhere to stage kit, not\n       a decorative border. The pattern is anchored at ORIGIN and tiles outward,\n       so the surround squares line up with the pitch squares for free. -->\n  <rect class=\"area\" x=\"1\" y=\"-35\" width=\"342\" height=\"279\" fill=\"url(#grass-big)\"></rect>\n  <rect x=\"1\" y=\"-35\" width=\"342\" height=\"279\" fill=\"url(#grid-big)\"></rect>\n  <!-- the touchline: the only thing that distinguishes pitch from surround -->\n  <rect class=\"pitch\" x=\"10\" y=\"10\" width=\"324\" height=\"204\" fill=\"none\" stroke=\"#ffffff\" stroke-width=\"1\"></rect>\n\n  <!-- the two goal ends, mirrored -->\n  <rect x=\"10\" y=\"52\" width=\"54\" height=\"120\" stroke=\"rgba(255,255,255,0.92)\" stroke-width=\"0.8\" fill=\"none\"></rect><rect x=\"10\" y=\"88\" width=\"18\" height=\"48\" stroke=\"rgba(255,255,255,0.92)\" stroke-width=\"0.6\" fill=\"none\"></rect><circle cx=\"46\" cy=\"112\" r=\"1\" fill=\"rgba(255,255,255,0.95)\"></circle><path d=\"M 64 88.75 A 29.4034 29.4034 0 0 1 64 135.25\" stroke=\"rgba(255,255,255,0.92)\" stroke-width=\"0.8\" fill=\"none\"></path>\n  <rect x=\"280\" y=\"52\" width=\"54\" height=\"120\" stroke=\"rgba(255,255,255,0.92)\" stroke-width=\"0.8\" fill=\"none\"></rect><rect x=\"316\" y=\"88\" width=\"18\" height=\"48\" stroke=\"rgba(255,255,255,0.92)\" stroke-width=\"0.6\" fill=\"none\"></rect><circle cx=\"298\" cy=\"112\" r=\"1\" fill=\"rgba(255,255,255,0.95)\"></circle><path d=\"M 280 88.75 A 29.4034 29.4034 0 0 0 280 135.25\" stroke=\"rgba(255,255,255,0.92)\" stroke-width=\"0.8\" fill=\"none\"></path>\n\n  <!-- centre -->\n  <line x1=\"172\" y1=\"10\" x2=\"172\" y2=\"214\" stroke=\"rgba(255,255,255,0.92)\" stroke-width=\"1\"></line>\n  <circle cx=\"172\" cy=\"112\" r=\"30\" stroke=\"rgba(255,255,255,0.92)\" stroke-width=\"0.8\" fill=\"none\"></circle>\n  <circle cx=\"172\" cy=\"112\" r=\"1.5\" fill=\"rgba(255,255,255,0.95)\"></circle>\n\n  <g class=\"ref-lines\"><line x1=\"10\" y1=\"52\" x2=\"334\" y2=\"52\" stroke=\"rgba(255,255,255,0.72)\" stroke-width=\"0.55\" stroke-dasharray=\"2.5 2.5\" fill=\"none\"></line><line x1=\"10\" y1=\"172\" x2=\"334\" y2=\"172\" stroke=\"rgba(255,255,255,0.72)\" stroke-width=\"0.55\" stroke-dasharray=\"2.5 2.5\" fill=\"none\"></line><line x1=\"64\" y1=\"88\" x2=\"280\" y2=\"88\" stroke=\"rgba(255,255,255,0.72)\" stroke-width=\"0.55\" stroke-dasharray=\"2.5 2.5\" fill=\"none\"></line><line x1=\"64\" y1=\"136\" x2=\"280\" y2=\"136\" stroke=\"rgba(255,255,255,0.72)\" stroke-width=\"0.55\" stroke-dasharray=\"2.5 2.5\" fill=\"none\"></line><line x1=\"118\" y1=\"10\" x2=\"118\" y2=\"214\" stroke=\"rgba(255,255,255,0.72)\" stroke-width=\"0.55\" stroke-dasharray=\"2.5 2.5\" fill=\"none\" data-cross=\"1\"></line><line x1=\"226\" y1=\"10\" x2=\"226\" y2=\"214\" stroke=\"rgba(255,255,255,0.72)\" stroke-width=\"0.55\" stroke-dasharray=\"2.5 2.5\" fill=\"none\" data-cross=\"1\"></line></g>\n\n  <g class=\"tape-layer\"></g>\n  <!-- Under the runs and the ball: a unit hull is the ground a block covers, so\n       it reads as territory rather than as another line drawn on top. -->\n  <g class=\"unit-layer\"><g class=\"unit\" data-unit=\"u71\" fill=\"#7dd3fc\" fill-opacity=\"0.07\" stroke=\"#7dd3fc\" stroke-opacity=\"0.4\" stroke-width=\"0.34\" stroke-dasharray=\"2 1.4\" stroke-linejoin=\"round\" stroke-linecap=\"round\"><line x1=\"19.00\" y1=\"119.80\" x2=\"19.00\" y2=\"119.80\"></line>\n             <text x=\"19.00\" y=\"119.80\" fill=\"#7dd3fc\" fill-opacity=\"0.55\" stroke=\"none\" font-size=\"2.6\" text-anchor=\"middle\" style=\"pointer-events:none\">Keeper</text></g><g class=\"unit on\" data-unit=\"u76\" fill=\"#7dd3fc\" fill-opacity=\"0.14\" stroke=\"#7dd3fc\" stroke-opacity=\"0.85\" stroke-width=\"0.5\" stroke-dasharray=\"2 1.4\" stroke-linejoin=\"round\" stroke-linecap=\"round\"><line x1=\"62.50\" y1=\"43.00\" x2=\"62.50\" y2=\"181.00\"></line>\n             <text x=\"62.50\" y=\"112.00\" fill=\"#7dd3fc\" fill-opacity=\"0.95\" stroke=\"none\" font-size=\"2.6\" text-anchor=\"middle\" style=\"pointer-events:none\">Back four</text></g><g class=\"unit\" data-unit=\"u81\" fill=\"#7dd3fc\" fill-opacity=\"0.07\" stroke=\"#7dd3fc\" stroke-opacity=\"0.4\" stroke-width=\"0.34\" stroke-dasharray=\"2 1.4\" stroke-linejoin=\"round\" stroke-linecap=\"round\"><line x1=\"158.81\" y1=\"53.99\" x2=\"158.81\" y2=\"191.99\"></line>\n             <text x=\"158.81\" y=\"122.99\" fill=\"#7dd3fc\" fill-opacity=\"0.55\" stroke=\"none\" font-size=\"2.6\" text-anchor=\"middle\" style=\"pointer-events:none\">Midfield four</text></g><g class=\"unit\" data-unit=\"u84\" fill=\"#7dd3fc\" fill-opacity=\"0.07\" stroke=\"#7dd3fc\" stroke-opacity=\"0.4\" stroke-width=\"0.34\" stroke-dasharray=\"2 1.4\" stroke-linejoin=\"round\" stroke-linecap=\"round\"><line x1=\"188.50\" y1=\"97.31\" x2=\"188.50\" y2=\"139.31\"></line>\n             <text x=\"188.50\" y=\"118.31\" fill=\"#7dd3fc\" fill-opacity=\"0.55\" stroke=\"none\" font-size=\"2.6\" text-anchor=\"middle\" style=\"pointer-events:none\">Front two</text></g><g class=\"unit\" data-unit=\"u86\" fill=\"#7dd3fc\" fill-opacity=\"0.07\" stroke=\"#7dd3fc\" stroke-opacity=\"0.4\" stroke-width=\"0.34\" stroke-dasharray=\"2 1.4\" stroke-linejoin=\"round\" stroke-linecap=\"round\"><line x1=\"325.00\" y1=\"119.80\" x2=\"325.00\" y2=\"119.80\"></line>\n             <text x=\"325.00\" y=\"119.80\" fill=\"#7dd3fc\" fill-opacity=\"0.55\" stroke=\"none\" font-size=\"2.6\" text-anchor=\"middle\" style=\"pointer-events:none\">Keeper</text></g><g class=\"unit\" data-unit=\"u91\" fill=\"#7dd3fc\" fill-opacity=\"0.07\" stroke=\"#7dd3fc\" stroke-opacity=\"0.4\" stroke-width=\"0.34\" stroke-dasharray=\"2 1.4\" stroke-linejoin=\"round\" stroke-linecap=\"round\"><line x1=\"287.87\" y1=\"68.48\" x2=\"287.87\" y2=\"185.20\"></line>\n             <text x=\"287.87\" y=\"126.84\" fill=\"#7dd3fc\" fill-opacity=\"0.55\" stroke=\"none\" font-size=\"2.6\" text-anchor=\"middle\" style=\"pointer-events:none\">Back four</text></g><g class=\"unit\" data-unit=\"u96\" fill=\"#7dd3fc\" fill-opacity=\"0.07\" stroke=\"#7dd3fc\" stroke-opacity=\"0.4\" stroke-width=\"0.34\" stroke-dasharray=\"2 1.4\" stroke-linejoin=\"round\" stroke-linecap=\"round\"><line x1=\"232.61\" y1=\"55.98\" x2=\"232.61\" y2=\"190.01\"></line>\n             <text x=\"232.61\" y=\"122.99\" fill=\"#7dd3fc\" fill-opacity=\"0.55\" stroke=\"none\" font-size=\"2.6\" text-anchor=\"middle\" style=\"pointer-events:none\">Midfield four</text></g><g class=\"unit\" data-unit=\"u99\" fill=\"#7dd3fc\" fill-opacity=\"0.07\" stroke=\"#7dd3fc\" stroke-opacity=\"0.4\" stroke-width=\"0.34\" stroke-dasharray=\"2 1.4\" stroke-linejoin=\"round\" stroke-linecap=\"round\"><line x1=\"155.50\" y1=\"97.31\" x2=\"155.50\" y2=\"139.31\"></line>\n             <text x=\"155.50\" y=\"118.31\" fill=\"#7dd3fc\" fill-opacity=\"0.55\" stroke=\"none\" font-size=\"2.6\" text-anchor=\"middle\" style=\"pointer-events:none\">Front two</text></g></g>\n  <g class=\"run-layer\"></g>\n  <g class=\"path-layer\"><line x1=\"181.37\" y1=\"90.21\" x2=\"447.63\" y2=\"190.79\" stroke=\"#fbbf24\" stroke-width=\"0.55\" stroke-dasharray=\"2 1.6\" stroke-linecap=\"round\" marker-end=\"url(#arw-big)\" opacity=\"0.95\"></line><line x1=\"447.61\" y1=\"192.15\" x2=\"181.39\" y2=\"283.85\" stroke=\"#fbbf24\" stroke-width=\"0.55\" stroke-dasharray=\"2 1.6\" stroke-linecap=\"round\" marker-end=\"url(#arw-big)\" opacity=\"0.95\"></line><g data-stop=\"0\">\n       <circle cx=\"177.1\" cy=\"87.1\" r=\"1.6\" fill=\"#fbbf24\" stroke=\"rgba(0,0,0,0.5)\" stroke-width=\"0.2\"></circle>\n       <text x=\"177.1\" y=\"87.75\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"2.2\" font-weight=\"700\" fill=\"#3b2600\">1</text>\n       <circle class=\"stop-hit\" cx=\"177.1\" cy=\"87.1\" r=\"2.6\"></circle>\n     </g><g data-stop=\"1\">\n       <circle cx=\"447.1\" cy=\"189.1\" r=\"1.6\" fill=\"#fbbf24\" stroke=\"rgba(0,0,0,0.5)\" stroke-width=\"0.2\"></circle>\n       <text x=\"447.1\" y=\"189.75\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"2.2\" font-weight=\"700\" fill=\"#3b2600\">2</text>\n       <circle class=\"stop-hit\" cx=\"447.1\" cy=\"189.1\" r=\"2.6\"></circle>\n     </g><g data-stop=\"2\">\n       <circle cx=\"177.1\" cy=\"282.1\" r=\"1.6\" fill=\"#fbbf24\" stroke=\"rgba(0,0,0,0.5)\" stroke-width=\"0.2\"></circle>\n       <text x=\"177.1\" y=\"282.75\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"2.2\" font-weight=\"700\" fill=\"#3b2600\">3</text>\n       <circle class=\"stop-hit\" cx=\"177.1\" cy=\"282.1\" r=\"2.6\"></circle>\n     </g></g>\n  <g class=\"item-layer\"><g class=\"item\" data-id=\"i70\" data-type=\"keeper\" transform=\"translate(19 119.80422161130545) rotate(94.67295495578826)\"><circle cx=\"0\" cy=\"0\" r=\"1.8\" fill=\"transparent\"></circle>\n          <path d=\"M 0 -1.40\n   C 0.92 -1.28, 1.40 -0.62, 1.40 0\n   A 1.40 1.40 0 0 1 -1.40 0\n   C -1.40 -0.62, -0.92 -1.28, 0 -1.40 Z\" fill=\"#16a34a\" stroke=\"rgba(0,0,0,0.55)\" stroke-width=\"0.16\" stroke-linejoin=\"round\"></path>\n          <circle cx=\"-0.520\" cy=\"-0.72\" r=\"0.25\" fill=\"#ffffff\" fill-opacity=\"0.78\"></circle><circle cx=\"0.520\" cy=\"-0.72\" r=\"0.25\" fill=\"#ffffff\" fill-opacity=\"0.78\"></circle>\n          <text x=\"0\" y=\"0.95\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"1.6\" font-weight=\"700\" fill=\"#ffffff\">1</text></g><g class=\"item\" data-id=\"i72\" data-type=\"playerBlue\" transform=\"translate(62.5 43) rotate(111.13153726355368)\"><circle cx=\"0\" cy=\"0\" r=\"1.8\" fill=\"transparent\"></circle>\n          <path d=\"M 0 -1.40\n   C 0.92 -1.28, 1.40 -0.62, 1.40 0\n   A 1.40 1.40 0 0 1 -1.40 0\n   C -1.40 -0.62, -0.92 -1.28, 0 -1.40 Z\" fill=\"#2563eb\" stroke=\"rgba(0,0,0,0.55)\" stroke-width=\"0.16\" stroke-linejoin=\"round\"></path>\n          <circle cx=\"-0.520\" cy=\"-0.72\" r=\"0.25\" fill=\"#ffffff\" fill-opacity=\"0.78\"></circle><circle cx=\"0.520\" cy=\"-0.72\" r=\"0.25\" fill=\"#ffffff\" fill-opacity=\"0.78\"></circle>\n          <text x=\"0\" y=\"0.95\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"1.6\" font-weight=\"700\" fill=\"#ffffff\">1</text></g><g class=\"item\" data-id=\"i73\" data-type=\"playerBlue\" transform=\"translate(62.5 88) rotate(102.17989106115019)\"><circle cx=\"0\" cy=\"0\" r=\"1.8\" fill=\"transparent\"></circle>\n          <path d=\"M 0 -1.40\n   C 0.92 -1.28, 1.40 -0.62, 1.40 0\n   A 1.40 1.40 0 0 1 -1.40 0\n   C -1.40 -0.62, -0.92 -1.28, 0 -1.40 Z\" fill=\"#2563eb\" stroke=\"rgba(0,0,0,0.55)\" stroke-width=\"0.16\" stroke-linejoin=\"round\"></path>\n          <circle cx=\"-0.520\" cy=\"-0.72\" r=\"0.25\" fill=\"#ffffff\" fill-opacity=\"0.78\"></circle><circle cx=\"0.520\" cy=\"-0.72\" r=\"0.25\" fill=\"#ffffff\" fill-opacity=\"0.78\"></circle>\n          <text x=\"0\" y=\"0.95\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"1.6\" font-weight=\"700\" fill=\"#ffffff\">2</text></g><g class=\"item\" data-id=\"i74\" data-type=\"playerBlue\" transform=\"translate(62.5 136) rotate(91.93602461890715)\"><circle cx=\"0\" cy=\"0\" r=\"1.8\" fill=\"transparent\"></circle>\n          <path d=\"M 0 -1.40\n   C 0.92 -1.28, 1.40 -0.62, 1.40 0\n   A 1.40 1.40 0 0 1 -1.40 0\n   C -1.40 -0.62, -0.92 -1.28, 0 -1.40 Z\" fill=\"#2563eb\" stroke=\"rgba(0,0,0,0.55)\" stroke-width=\"0.16\" stroke-linejoin=\"round\"></path>\n          <circle cx=\"-0.520\" cy=\"-0.72\" r=\"0.25\" fill=\"#ffffff\" fill-opacity=\"0.78\"></circle><circle cx=\"0.520\" cy=\"-0.72\" r=\"0.25\" fill=\"#ffffff\" fill-opacity=\"0.78\"></circle>\n          <text x=\"0\" y=\"0.95\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"1.6\" font-weight=\"700\" fill=\"#ffffff\">3</text></g><g class=\"item\" data-id=\"i75\" data-type=\"playerBlue\" transform=\"translate(62.5 181) rotate(82.20707140127072)\"><circle cx=\"0\" cy=\"0\" r=\"1.8\" fill=\"transparent\"></circle>\n          <path d=\"M 0 -1.40\n   C 0.92 -1.28, 1.40 -0.62, 1.40 0\n   A 1.40 1.40 0 0 1 -1.40 0\n   C -1.40 -0.62, -0.92 -1.28, 0 -1.40 Z\" fill=\"#2563eb\" stroke=\"rgba(0,0,0,0.55)\" stroke-width=\"0.16\" stroke-linejoin=\"round\"></path>\n          <circle cx=\"-0.520\" cy=\"-0.72\" r=\"0.25\" fill=\"#ffffff\" fill-opacity=\"0.78\"></circle><circle cx=\"0.520\" cy=\"-0.72\" r=\"0.25\" fill=\"#ffffff\" fill-opacity=\"0.78\"></circle>\n          <text x=\"0\" y=\"0.95\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"1.6\" font-weight=\"700\" fill=\"#ffffff\">4</text></g><g class=\"item\" data-id=\"i77\" data-type=\"playerBlue\" transform=\"translate(158.8115249270108 53.9942179866213) rotate(118.51169113337102)\"><circle cx=\"0\" cy=\"0\" r=\"1.8\" fill=\"transparent\"></circle>\n          <path d=\"M 0 -1.40\n   C 0.92 -1.28, 1.40 -0.62, 1.40 0\n   A 1.40 1.40 0 0 1 -1.40 0\n   C -1.40 -0.62, -0.92 -1.28, 0 -1.40 Z\" fill=\"#2563eb\" stroke=\"rgba(0,0,0,0.55)\" stroke-width=\"0.16\" stroke-linejoin=\"round\"></path>\n          <circle cx=\"-0.520\" cy=\"-0.72\" r=\"0.25\" fill=\"#ffffff\" fill-opacity=\"0.78\"></circle><circle cx=\"0.520\" cy=\"-0.72\" r=\"0.25\" fill=\"#ffffff\" fill-opacity=\"0.78\"></circle>\n          <text x=\"0\" y=\"0.95\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"1.6\" font-weight=\"700\" fill=\"#ffffff\">5</text></g><g class=\"item\" data-id=\"i78\" data-type=\"playerBlue\" transform=\"translate(158.8115249270108 98.99421798662131) rotate(105.3419065070563)\"><circle cx=\"0\" cy=\"0\" r=\"1.8\" fill=\"transparent\"></circle>\n          <path d=\"M 0 -1.40\n   C 0.92 -1.28, 1.40 -0.62, 1.40 0\n   A 1.40 1.40 0 0 1 -1.40 0\n   C -1.40 -0.62, -0.92 -1.28, 0 -1.40 Z\" fill=\"#2563eb\" stroke=\"rgba(0,0,0,0.55)\" stroke-width=\"0.16\" stroke-linejoin=\"round\"></path>\n          <circle cx=\"-0.520\" cy=\"-0.72\" r=\"0.25\" fill=\"#ffffff\" fill-opacity=\"0.78\"></circle><circle cx=\"0.520\" cy=\"-0.72\" r=\"0.25\" fill=\"#ffffff\" fill-opacity=\"0.78\"></circle>\n          <text x=\"0\" y=\"0.95\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"1.6\" font-weight=\"700\" fill=\"#ffffff\">6</text></g><g class=\"item\" data-id=\"i79\" data-type=\"playerBlue\" transform=\"translate(158.8115249270108 146.9942179866213) rotate(89.28764699360026)\"><circle cx=\"0\" cy=\"0\" r=\"1.8\" fill=\"transparent\"></circle>\n          <path d=\"M 0 -1.40\n   C 0.